# Modo de extracción:
#   local -> lee el PDF en el navegador y extrae la información real (no necesita backend)
#   real  -> envía el PDF al backend REST (endpoints del contrato)
VITE_API_MODE=local

# Base de la API real. Dejar vacío en desarrollo para usar el proxy de Vite ("/api/...").
# En producción (Vercel/Netlify) poner la URL completa del backend, si permite CORS.
VITE_API_BASE_URL=

# Destino del proxy de desarrollo (solo lo lee vite.config.ts)
VITE_API_PROXY_TARGET=https://finesa-front-demo-1063009710641.us-east4.run.app

# Polling (milisegundos) y tiempo máximo de espera
VITE_POLL_INTERVAL_MS=4000
VITE_POLL_TIMEOUT_MS=120000

# Tamaño máximo del PDF en MB
VITE_MAX_FILE_MB=10
